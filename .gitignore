# macOS
.DS_Store

# A local JUCE checkout, if one exists. Tracking it as a symlink leaked a
# local path and left every clone with a dangling link; CMake fetches JUCE
# itself when the directory is absent, which is what CI has always done.
/JUCE

# Plugin CMake build output
/build/
/installer/build/
/installer/dist/

# ESP-IDF firmware build output (regenerated by idf.py; sdkconfig itself is
# also generated from sdkconfig.defaults, see OnAirLinkFirmware/sdkconfig.defaults)
OnAirLinkFirmware/build/
OnAirLinkFirmware/sdkconfig
OnAirLinkFirmware/sdkconfig.old
OnAirLinkFirmware/managed_components/
OnAirLinkFirmware/dependencies.lock
OnAirLinkFirmware/dist/
OnAirLinkFirmware/tools/.venv/

# Flasher app bundle build output (regenerated by tools/build_flasher_app.sh)
OnAirLinkFirmware/tools/build/
OnAirLinkFirmware/tools/dist/

# Windows installer build output
/installer/windows/build/
/installer/windows/*.exe
