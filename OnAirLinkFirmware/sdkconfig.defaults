# Defaults applied on a fresh build (sdkconfig itself is git-ignored).

# A large app partition (no OTA). The firmware fits comfortably, but the
# layout is kept so an update cannot be blocked by a partition table change.
CONFIG_PARTITION_TABLE_SINGLE_APP_LARGE=y

# 1 kHz FreeRTOS tick.
CONFIG_FREERTOS_HZ=1000

# app_main runs the display/HUD loop; give it headroom.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

# The ESP32-C3's only USB is the USB-Serial/JTAG peripheral; route the console
# there so logs appear over /dev/cu.usbmodem* (default is UART0).
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# Default LWIP_MAX_SOCKETS=10 is too low: the HTTP captive portal alone
# reserves several (HTTPD_DEFAULT_CONFIG max_open_sockets), leaving too few
# for our own UDP tasks (provisioning, control, announce, DNS). Keep the pool
# well above what we need.
CONFIG_LWIP_MAX_SOCKETS=16

# Nothing in this firmware throws (checked: no throw/try/catch anywhere).
# Leaving exceptions off saves flash and avoids pulling in the unwinder.
CONFIG_COMPILER_CXX_EXCEPTIONS=n

# No Bluetooth anywhere in this project. The NimBLE stack used to be compiled
# in for a "plugin via Bluetooth" mode that was removed; the config outlived
# the code and was still costing flash and RAM for nothing.
CONFIG_BT_ENABLED=n
